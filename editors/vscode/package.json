{
  "name": "kobra",
  "displayName": "Kobra",
  "description": "Kobra language support: syntax highlighting, the Kobra language server (`k lsp`) and the preview panel (`k preview`).",
  "version": "0.1.0-rc.1",
  "publisher": "slavkobojanic",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slavkobojanic/kobra"
  },
  "homepage": "https://github.com/slavkobojanic/kobra",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/k.toml",
    "onLanguage:k"
  ],
  "contributes": {
    "languages": [
      {
        "id": "k",
        "aliases": [
          "Kobra",
          "k"
        ],
        "extensions": [
          ".k"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "k",
        "scopeName": "source.k",
        "path": "./syntaxes/k.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Kobra",
      "properties": {
        "k.server.path": {
          "type": "string",
          "default": "k",
          "markdownDescription": "The `k` executable that runs the language server (`k lsp`). A bare name is looked up on `PATH`."
        },
        "k.server.extraEnv": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra environment variables for the language server process."
        },
        "k.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Kobra language server in the output panel."
        },
        "kobra.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open the Kobra Preview panel beside the editor when a `.k` file with a `preview` becomes the active editor. Closing the panel keeps it closed until **Kobra: Open Preview** or a **▶ Preview** CodeLens opens it again. The panel runs `k preview --editor` with `#k.server.path#` and `#k.server.extraEnv#`."
        }
      }
    },
    "configurationDefaults": {
      "[k]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      {
        "command": "k.restartServer",
        "title": "Kobra: Restart Language Server"
      },
      {
        "command": "kobra.preview.open",
        "title": "Kobra: Open Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "kobra.preview.toggleGrid",
        "title": "Kobra: Toggle Preview Grid",
        "icon": "$(layout)"
      },
      {
        "command": "kobra.preview.revealError",
        "title": "Kobra: Go to Preview Error"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kobra.preview.open",
          "when": "resourceLangId == k",
          "group": "navigation"
        },
        {
          "command": "kobra.preview.toggleGrid",
          "when": "activeWebviewPanelId == 'kobra.preview'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kobra.preview.open",
          "when": "editorLangId == k"
        },
        {
          "command": "kobra.preview.revealError",
          "when": "false"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
