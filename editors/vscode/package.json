{
  "name": "kobra",
  "displayName": "Kobra",
  "description": "Kobra language support: syntax highlighting and the Kobra language server (`k lsp`).",
  "version": "0.1.0",
  "publisher": "slavkobojanic",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/slavkobojanic/kobra"
  },
  "homepage": "https://slavkobojanic.github.io/kobra/",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/k.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "k",
        "aliases": [
          "Kobra",
          "k"
        ],
        "extensions": [
          ".k"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "k",
        "scopeName": "source.k",
        "path": "./syntaxes/k.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Kobra",
      "properties": {
        "k.server.path": {
          "type": "string",
          "default": "k",
          "markdownDescription": "The `k` executable that runs the language server (`k lsp`). A bare name is looked up on `PATH`."
        },
        "k.server.extraEnv": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra environment variables for the language server process."
        },
        "k.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Kobra language server in the output panel."
        }
      }
    },
    "configurationDefaults": {
      "[k]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      {
        "command": "k.restartServer",
        "title": "Kobra: Restart Language Server"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
