/target
/fuzz/target
/fuzz/corpus
/fuzz/corpus-old
/fuzz/artifacts
/fuzz/Cargo.lock

# Agent worktrees
.claude/worktrees/

# A project's local development state: `.env` (copied from `.env.example`)
# and `.k/` (development databases, generated development secrets, caught
# mail). Neither is ever committed.
.env
.k/
# A test project's `.env` is a fixture the tests read: committed, so a
# fresh checkout runs them (crates/xtask/tests/checkout.rs).
!/crates/*/tests/**/.env
!/tests/**/.env

# Build output of `k build`, in every project (examples, test projects).
dist/

# Editor extension packaging.
node_modules/
*.vsix

# OS and tool noise.
.DS_Store
*.log
