/// A locale for formatting numbers, dates and money, set with
/// `locale(...)` in `metadata` ([`MetadataEntries.locale`],
/// `docs/design/22-metadata.md`). The cases
/// listed are those the examples use.
public enum Locale {
    /// English.
    case english
    /// German.
    case german
    /// French.
    case french
    /// Portuguese.
    case portuguese
    /// Japanese.
    case japanese
}
