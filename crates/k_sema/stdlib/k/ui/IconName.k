/// The icons of the bundled set. The cases listed are those the examples
/// use; the set has more.
public enum IconName implements Equatable, Hashable, Codable {
    /// A sun.
    case sun
    /// A moon.
    case moon
    /// A cloud.
    case cloud
    /// A cloud with the sun behind it.
    case cloudSun
    /// Rain.
    case rain
    /// Snow.
    case snow
    /// A thunderstorm.
    case thunderstorm
    /// Fog.
    case fog
    /// A pin.
    case pin
    /// A trash can.
    case trash
    /// A check mark.
    case check
    /// A cross.
    case close
    /// A cloud in front of the moon.
    case cloudMoon
    /// A cloud with fog below it.
    case cloudFog
    /// Drizzle.
    case cloudDrizzle
    /// Rain from a cloud.
    case cloudRain
    /// A snowflake.
    case snowflake
    /// A thunderstorm cloud.
    case cloudLightning
    /// A question mark in a circle.
    case circleHelp
    /// An arrow pointing up, rotated to show a direction such as the wind's.
    case arrowUp
}
