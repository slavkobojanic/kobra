/// The app's view pages, generated by the compiler: one case per `page`
/// without HTTP handlers, with the page's `@Param`s as associated values
/// (`docs/design/12-routing.md`, "Navigation").
///
/// Required parameters are named arguments (`.product(id: 42)`); optional
/// ones are chained (`.product(id: 42).tab(.reviews)`). Needs no import.
@Generated
public enum Page implements Equatable, Hashable, Codable {
    /// The page's path and query, such as `/product/42?tab=reviews`.
    @Native
    var url: Url
}
