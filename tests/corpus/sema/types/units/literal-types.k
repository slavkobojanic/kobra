// Unit literals have their nominal unit types.
let width = 16px
  //^^^^^ type: Length
let size = 1.5rem
  //^^^^ type: Length
let column = 1fr
  //^^^^^^ type: Length
let half = 50%
  //^^^^ type: Percent
let delay = 200ms
  //^^^^^ type: Duration
let long = 2s
  //^^^^ type: Duration
let turn = 45deg
  //^^^^ type: Angle
let brand = #3B82F6
  //^^^^^ type: Color
