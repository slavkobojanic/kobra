public theme BrandTokens {
    font body: Font = Font(
        family: "PP Neue Gstaad",
        size: 16px,
        faces: [
            FontFace("fonts/PPNeueGstaad-Regular.woff2", weight: 400),
            FontFace("fonts/PPNeueGstaad-Bold.woff2", weight: 700),
            FontFace("fonts/PPNeueGstaad-Bolt.woff2", weight: 800),
            FontFace("../site/fonts/Other.woff2", weight: 300),
            FontFace("fonts/PPNeueGstaad-Italic.ttf", style: .italic),
            FontFace("fonts/Renamed.woff2", weight: 500),
            FontFace("fonts/Broken.woff2", weight: 600),
            FontFace("fonts/PPNeueGstaad-Regular.woff2", weight: 1200),
        ]
    )
}
