// Numbers with every kind of unit, including negative values, which are single literals in style mode.
component T {
    style {
        .a {
            margin: -4px;
            zIndex: -1;
            lineHeight: 1.5;
            width: 50%;
            opacity: 0;
            rotate: 45deg;
            transitionDuration: 200ms;
            animationDelay: 0.2s;
            gap: 1.5rem;
            height: 100dvh;
            flexGrow: 1fr;
        }
    }
}
