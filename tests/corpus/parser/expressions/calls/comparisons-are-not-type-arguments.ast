; `<` and `>` stay comparisons unless written as type arguments: spaced, lowercase or across lines
(SourceFile
  (FieldDecl let a =
    (CallExpr
      (NameExpr f)
      (ArgList
        (Arg (BinaryExpr (NameExpr x) < (NameExpr y)))
        (Arg (BinaryExpr (NameExpr z) > (ParenExpr (NameExpr w)))))))
  (FieldDecl let b =
