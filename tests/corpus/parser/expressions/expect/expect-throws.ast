(SourceFile
  (TestCaseDecl test
    (StringLit "errors")
    (Block
      (ExpectThrowsStmt expect throws
        (EnumCasePattern CartError outOfStock)
        (Block
          (TryExpr try
            (AwaitExpr await
              (CallExpr
                (MemberExpr (NameExpr cart) add)
                (ArgList (Arg product (ImplicitMemberExpr soldOut))))))))
      (ExpectThrowsStmt expect throws
