; ifs nested inside branches
(SourceFile
  (FuncDecl func f
    (ParamList)
    (Block
      (IfExpr if
        (NameExpr a)
        (Block
          (IfExpr if
            (NameExpr b)
            (Block
              (IfExpr if
                (NameExpr c)
                (Block (CallExpr (NameExpr x) (ArgList)))
                else
                (Block (CallExpr (NameExpr y) (ArgList)))))))))))
