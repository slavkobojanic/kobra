; One file may hold every kind of top-level item, in any order.
(SourceFile
  (Import import (ImportPath shop Money))
  (Import import proto (StringLit "billing/v1/invoice.proto"))
  (ComponentDecl component C (MemberList))
  (PageDecl page P (MemberList))
  (LayoutDecl layout L (MemberList))
  (ServiceDecl service S (MemberList))
  (ProtocolDecl protocol Pr (MemberList))
  (EntityDecl entity En (MemberList))
  (RepositoryDecl repository R (ForClause for (PathType En)) (MemberList))
  (StructDecl struct St (MemberList))
  (EnumDecl enum Em (MemberList))
  (ClassDecl class Cl (MemberList))
  (InterfaceDecl interface I (MemberList))
  (ThemeDecl theme T (MemberList))
  (AppDecl app A (MemberList))
  (ExtendDecl extend (PathType Int) (MemberList))
  (TestSuiteDecl test Suite (MemberList))
  (TestCaseDecl test (StringLit "case") (Block))
  (FuncDecl func f (ParamList) (Block))
  (FieldDecl let constant = (Literal 1)))
