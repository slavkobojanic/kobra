; Bodiless functions are requirements; functions with bodies are defaults.
(SourceFile
  (InterfaceDecl interface PaymentProvider
    (MemberList
      (FuncDecl func charge (ParamList (Param amount (PathType Money)) (Param card (PathType CardToken))) async
        (ThrowsClause throws (PathType PaymentError))
        (ReturnType (PathType Receipt)))
      (FuncDecl func supports (ParamList (Param currency (PathType Currency))) (ReturnType (PathType Bool))
        (Block (ReturnStmt return (BinaryExpr (NameExpr currency) == (ImplicitMemberExpr usd)))))
      (FuncDecl func refund (ParamList (Param receipt (PathType Receipt))) async
        (ThrowsClause throws (PathType PaymentError))))))
