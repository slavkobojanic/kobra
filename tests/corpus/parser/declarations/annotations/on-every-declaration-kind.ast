; Annotations may precede every kind of declaration and member.
(SourceFile
  (ComponentDecl (Annotation A) component C (MemberList))
  (PageDecl (Annotation A) page P (MemberList))
  (LayoutDecl (Annotation A) layout L (MemberList))
  (ServiceDecl (Annotation A) service S (MemberList))
  (ProtocolDecl (Annotation A) protocol Pr (MemberList))
  (EntityDecl (Annotation A) entity En (MemberList))
  (RepositoryDecl (Annotation A) repository R (ForClause for (PathType En)) (MemberList))
  (StructDecl (Annotation A) struct St (MemberList))
  (EnumDecl (Annotation A) enum Em (MemberList (EnumCase (Annotation B) case one)))
  (ClassDecl (Annotation A) class Cl (MemberList (InitDecl (Annotation B) init (ParamList) (Block))))
  (InterfaceDecl (Annotation A) interface I (MemberList))
  (ThemeDecl (Annotation A) theme T (MemberList))
  (AppDecl (Annotation A) app Ap (MemberList))
  (ExtendDecl (Annotation A) extend (PathType Int) (MemberList))
  (TestSuiteDecl (Annotation A) test Suite (MemberList))
  (TestCaseDecl (Annotation A) test (StringLit "case") (Block))
  (FuncDecl (Annotation A) func f (ParamList) (Block))
  (FieldDecl (Annotation A) let x = (Literal 1))
  (ProtocolDecl (Annotation A) protocol Q (MemberList (RpcDecl (Annotation B) rpc r (ParamList)))))
