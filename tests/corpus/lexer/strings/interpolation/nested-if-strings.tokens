# The example from grammar.md 4.2: nested blocks and nested strings.
StringStart "\""
InterpStart "{"
IfKw "if"
Ident "a"
LBrace "{"
StringStart "\""
StringText "x"
StringEnd "\""
RBrace "}"
ElseKw "else"
LBrace "{"
StringStart "\""
StringText "y"
StringEnd "\""
RBrace "}"
InterpEnd "}"
StringEnd "\""
Newline "\n"
