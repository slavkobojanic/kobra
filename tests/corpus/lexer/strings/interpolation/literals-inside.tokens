# Units, colors, percents and floats inside interpolations.
StringStart "\""
InterpStart "{"
UnitLit "16px"
Plus "+"
UnitLit "2rem"
InterpEnd "}"
StringText " "
InterpStart "{"
ColorLit "#fff"
InterpEnd "}"
StringText " "
InterpStart "{"
UnitLit "50%"
InterpEnd "}"
StringText " "
InterpStart "{"
FloatLit "1.5"
InterpEnd "}"
StringEnd "\""
Newline "\n"
