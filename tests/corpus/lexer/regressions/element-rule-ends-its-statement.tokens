# Regression: `button { ... }` at a statement start (RA-8) is lexed as a declaration whose `{`
# opens an interpolation. The `;` inside it is code mode and did not end the statement, so the
# style frame stayed in the declaration state after the `}` and `.a {` was lexed as another
# interpolation. An interpolation opened before the declaration's `:` ends its statement when it
# closes; one in a value (`padding: {x} {y};`) does not.
StyleKw "style"
LBrace "{"
Newline "\n"
Ident "button"
InterpStart "{"
Ident "color"
Colon ":"
Ident "red"
Semicolon ";"
InterpEnd "}"
Newline "\n"
Dot "."
Ident "a"
LBrace "{"
Ident "color"
Colon ":"
Ident "blue"
Semicolon ";"
RBrace "}"
Newline "\n"
Ident "padding"
Colon ":"
InterpStart "{"
Ident "x"
InterpEnd "}"
InterpStart "{"
Ident "y"
InterpEnd "}"
Semicolon ";"
Newline "\n"
Ident "b"
Colon ":"
Ident "c"
Newline "\n"
RBrace "}"
Newline "\n"
