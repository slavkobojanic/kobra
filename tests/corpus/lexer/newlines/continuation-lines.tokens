# A Newline token is produced before a leading `.`; deciding that the line
# continues is the parser's job (grammar.md 5).
LetKw "let"
Ident "inStock"
Eq "="
Ident "products"
Newline "\n"
Dot "."
Ident "filter"
LBrace "{"
Ident "product"
FatArrow "=>"
Ident "product"
Dot "."
Ident "stock"
Gt ">"
IntLit "0"
RBrace "}"
Newline "\n"
