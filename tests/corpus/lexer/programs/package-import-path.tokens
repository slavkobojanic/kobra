# Import paths are ordinary tokens: the parser joins them (no trivia inside).
ImportKw "import"
Ident "github"
Dot "."
Ident "com"
Slash "/"
Ident "acme"
Slash "/"
Ident "my"
Minus "-"
Ident "charts"
Dot "."
Ident "LineChart"
Newline "\n"
ImportKw "import"
Ident "proto"
StringStart "\""
StringText "billing/v1/invoice.proto"
StringEnd "\""
Newline "\n"
