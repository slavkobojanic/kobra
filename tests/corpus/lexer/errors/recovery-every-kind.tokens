# One bad construct per line; every one is reported and the lines between
# them are lexed normally.
LetKw "let"
Ident "a"
Eq "="
Error "$"
Newline "\n"
LetKw "let"
Ident "s"
Eq "="
StringStart "\""
StringText "abc"
Newline "\n"
LetKw "let"
Ident "c"
Eq "="
ColorLit "#12"
Newline "\n"
LetKw "let"
Ident "n"
Eq "="
IntLit "0x"
Newline "\n"
LetKw "let"
Ident "e"
Eq "="
StringStart "\""
StringEscape "\\q"
StringEnd "\""
Newline "\n"
BlockComment "/* open\n"
