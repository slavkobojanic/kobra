# Every multi-character operator, separated by spaces.
QuestionDot "?."
QuestionQuestion "??"
Arrow "->"
FatArrow "=>"
EqEq "=="
BangEq "!="
LtEq "<="
GtEq ">="
PlusEq "+="
MinusEq "-="
StarEq "*="
SlashEq "/="
PercentEq "%="
AmpAmp "&&"
PipePipe "||"
DotDot ".."
DotDotLt "..<"
DotDotDot "..."
Newline "\n"
