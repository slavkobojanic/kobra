# Every single-character punctuation token, separated by spaces.
LParen "("
RParen ")"
LBrack "["
RBrack "]"
LBrace "{"
RBrace "}"
Comma ","
Colon ":"
Semicolon ";"
Dot "."
Question "?"
At "@"
Eq "="
Bang "!"
Lt "<"
Gt ">"
Plus "+"
Minus "-"
Star "*"
Slash "/"
Percent "%"
Amp "&"
Pipe "|"
Tilde "~"
Underscore "_"
Newline "\n"
