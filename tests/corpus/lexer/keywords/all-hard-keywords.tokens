# Every hard keyword, one per line, lexes to its own `...Kw` kind.
# (`style` is followed by a newline and `throw`, so it does not enter
# style mode.)
AndKw "and"
Newline "\n"
AsKw "as"
Newline "\n"
AsyncKw "async"
Newline "\n"
AwaitKw "await"
Newline "\n"
BindKw "bind"
Newline "\n"
BreakKw "break"
Newline "\n"
CaseKw "case"
Newline "\n"
CatchKw "catch"
Newline "\n"
ClassKw "class"
Newline "\n"
ContinueKw "continue"
Newline "\n"
DefaultKw "default"
Newline "\n"
DoKw "do"
Newline "\n"
ElseKw "else"
Newline "\n"
EnumKw "enum"
Newline "\n"
ExpectKw "expect"
Newline "\n"
ExtendKw "extend"
Newline "\n"
FalseKw "false"
Newline "\n"
ForKw "for"
Newline "\n"
FuncKw "func"
Newline "\n"
GuardKw "guard"
Newline "\n"
IfKw "if"
Newline "\n"
ImplementsKw "implements"
Newline "\n"
ImportKw "import"
Newline "\n"
InKw "in"
Newline "\n"
InitKw "init"
Newline "\n"
InterfaceKw "interface"
Newline "\n"
IsKw "is"
Newline "\n"
LetKw "let"
Newline "\n"
MatchKw "match"
Newline "\n"
NilKw "nil"
Newline "\n"
NotKw "not"
Newline "\n"
OrKw "or"
Newline "\n"
PrivateKw "private"
Newline "\n"
PublicKw "public"
Newline "\n"
RequiresKw "requires"
Newline "\n"
ReturnKw "return"
Newline "\n"
RpcKw "rpc"
Newline "\n"
SelfKw "self"
Newline "\n"
StaticKw "static"
Newline "\n"
StructKw "struct"
Newline "\n"
StyleKw "style"
Newline "\n"
ThrowKw "throw"
Newline "\n"
ThrowsKw "throws"
Newline "\n"
TrueKw "true"
Newline "\n"
TryKw "try"
Newline "\n"
UseKw "use"
Newline "\n"
VarKw "var"
