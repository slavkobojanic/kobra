# Units, percents, floats and `/` in style values.
StyleKw "style"
LBrace "{"
Newline "\n"
Dot "."
Ident "a"
LBrace "{"
Newline "\n"
Ident "gridTemplateColumns"
Colon ":"
UnitLit "1fr"
UnitLit "2fr"
Semicolon ";"
Newline "\n"
Ident "transform"
Colon ":"
Ident "rotate"
LParen "("
UnitLit "45deg"
RParen ")"
Semicolon ";"
Newline "\n"
Ident "transition"
Colon ":"
Ident "opacity"
UnitLit "200ms"
Semicolon ";"
Newline "\n"
Ident "width"
Colon ":"
UnitLit "50%"
Semicolon ";"
Newline "\n"
Ident "height"
Colon ":"
UnitLit "100vh"
Semicolon ";"
Newline "\n"
Ident "lineHeight"
Colon ":"
FloatLit "1.5"
Semicolon ";"
Newline "\n"
Ident "aspectRatio"
Colon ":"
IntLit "16"
Slash "/"
IntLit "9"
Semicolon ";"
Newline "\n"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
