# A statement starting with a digit is a selector, so `0% {` opens a block.
StyleKw "style"
LBrace "{"
At "@"
Ident "keyframes"
Ident "fade"
LBrace "{"
UnitLit "0%"
LBrace "{"
Ident "opacity"
Colon ":"
IntLit "0"
Semicolon ";"
RBrace "}"
UnitLit "100%"
LBrace "{"
Ident "opacity"
Colon ":"
IntLit "1"
Semicolon ";"
RBrace "}"
RBrace "}"
RBrace "}"
Newline "\n"
