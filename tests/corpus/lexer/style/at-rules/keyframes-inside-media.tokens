LBrace "{"
At "@"
Ident "keyframes"
Ident "f"
LBrace "{"
Ident "to"
LBrace "{"
Ident "a"
Colon ":"
Ident "b"
Semicolon ";"
RBrace "}"
RBrace "}"
RBrace "}"
RBrace "}"
