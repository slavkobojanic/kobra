# Inside a `@keyframes` block, a statement starting with a letter (`from`,
# `to`) is a selector, so its `{` opens a block instead of an interpolation.
StyleKw "style"
LBrace "{"
At "@"
Ident "keyframes"
Ident "fade"
LBrace "{"
Ident "from"
LBrace "{"
Ident "opacity"
Colon ":"
IntLit "0"
Semicolon ";"
RBrace "}"
UnitLit "50%"
LBrace "{"
Ident "opacity"
Colon ":"
FloatLit "0.5"
Semicolon ";"
RBrace "}"
Ident "to"
LBrace "{"
Ident "opacity"
Colon ":"
IntLit "1"
Semicolon ";"
RBrace "}"
RBrace "}"
RBrace "}"
Newline "\n"
