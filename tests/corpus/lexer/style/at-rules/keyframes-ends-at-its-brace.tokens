# The keyframes block ends at its `}`: in the rule after it, `from {` is again
# a declaration whose `{` opens an interpolation (the element-rule shape of RA-8).
StyleKw "style"
LBrace "{"
At "@"
Ident "keyframes"
Ident "pulse"
LBrace "{"
Ident "from"
Comma ","
Ident "to"
LBrace "{"
Ident "a"
Colon ":"
Ident "b"
Semicolon ";"
RBrace "}"
RBrace "}"
Dot "."
Ident "c"
LBrace "{"
Ident "from"
InterpStart "{"
InterpEnd "}"
RBrace "}"
RBrace "}"
Newline "\n"
