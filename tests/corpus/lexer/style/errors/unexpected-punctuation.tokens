# Style mode allows only a limited set of punctuation; `?`, `<`, `|` and `$`
# are unexpected characters there.
StyleKw "style"
LBrace "{"
Newline "\n"
Dot "."
Ident "a"
LBrace "{"
Newline "\n"
Ident "b"
Colon ":"
Ident "c"
Error "?"
Ident "d"
Semicolon ";"
Newline "\n"
Ident "e"
Colon ":"
Ident "f"
Error "<"
Ident "g"
Semicolon ";"
Newline "\n"
Ident "h"
Colon ":"
Ident "i"
Error "|"
Ident "j"
Semicolon ";"
Newline "\n"
Ident "k"
Colon ":"
Error "$"
Ident "l"
Semicolon ";"
Newline "\n"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
