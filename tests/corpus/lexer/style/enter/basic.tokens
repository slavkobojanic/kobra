# `style {` enters style mode: `.card` starts a selector statement (its `{` is
# LBrace), `padding` starts a declaration.
StyleKw "style"
LBrace "{"
Newline "\n"
Dot "."
Ident "card"
LBrace "{"
Newline "\n"
Ident "padding"
Colon ":"
Dot "."
Ident "md"
Semicolon ";"
Newline "\n"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
