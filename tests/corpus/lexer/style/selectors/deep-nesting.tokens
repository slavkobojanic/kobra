# Five nested rules; each `}` decrements the depth until the last one closes
# the style block.
StyleKw "style"
LBrace "{"
Dot "."
Ident "a"
LBrace "{"
Dot "."
Ident "b"
LBrace "{"
Dot "."
Ident "c"
LBrace "{"
Dot "."
Ident "d"
LBrace "{"
Amp "&"
Colon ":"
Ident "hover"
LBrace "{"
Ident "x"
Colon ":"
Ident "y"
Semicolon ";"
RBrace "}"
RBrace "}"
RBrace "}"
RBrace "}"
RBrace "}"
RBrace "}"
Newline "\n"
