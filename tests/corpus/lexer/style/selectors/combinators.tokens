Newline "\n"
Dot "."
Ident "a"
Gt ">"
Dot "."
Ident "b"
LBrace "{"
RBrace "}"
Newline "\n"
Dot "."
Ident "a"
Plus "+"
Dot "."
Ident "b"
LBrace "{"
RBrace "}"
Newline "\n"
Dot "."
Ident "a"
Tilde "~"
Dot "."
Ident "b"
LBrace "{"
RBrace "}"
Newline "\n"
Dot "."
Ident "a"
Dot "."
Ident "b"
LBrace "{"
RBrace "}"
Newline "\n"
Star "*"
LBrace "{"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
