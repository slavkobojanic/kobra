# In style mode identifiers may contain `-` (and digits) after the first
# character.
StyleKw "style"
LBrace "{"
Newline "\n"
Dot "."
Ident "row"
LBrace "{"
Newline "\n"
Ident "fontFamily"
Colon ":"
StringStart "\""
StringText "Inter"
StringEnd "\""
Comma ","
Ident "sans-serif"
Semicolon ";"
Newline "\n"
Ident "justifyContent"
Colon ":"
Ident "space-between"
Semicolon ";"
Newline "\n"
Ident "gridArea"
Colon ":"
Ident "row-1"
Semicolon ";"
Newline "\n"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
