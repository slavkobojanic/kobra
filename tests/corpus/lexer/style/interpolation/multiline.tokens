# grammar.md 4.2: inside a style value an interpolation may span lines (no
# K0002, no early end).
StyleKw "style"
LBrace "{"
Newline "\n"
Dot "."
Ident "a"
LBrace "{"
Newline "\n"
Ident "width"
Colon ":"
InterpStart "{"
Newline "\n"
Ident "size"
Newline "\n"
InterpEnd "}"
Semicolon ";"
Newline "\n"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
