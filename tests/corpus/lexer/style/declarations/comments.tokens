# Comments in style mode; trivia before a statement is skipped when deciding
# its kind, so `color` still starts a declaration (`{` is InterpStart).
StyleKw "style"
LBrace "{"
Newline "\n"
LineComment "// rules"
Newline "\n"
Dot "."
Ident "a"
LBrace "{"
BlockComment "/* c */"
Ident "color"
Colon ":"
InterpStart "{"
Ident "c"
InterpEnd "}"
Semicolon ";"
RBrace "}"
DocComment "/// doc"
Newline "\n"
RBrace "}"
Newline "\n"
