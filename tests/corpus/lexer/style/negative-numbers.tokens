# In style mode `-` directly before a digit starts a negative literal.
StyleKw "style"
LBrace "{"
Dot "."
Ident "a"
LBrace "{"
Ident "margin"
Colon ":"
UnitLit "-4px"
Semicolon ";"
Ident "zIndex"
Colon ":"
IntLit "-1"
Semicolon ";"
Ident "opacity"
Colon ":"
FloatLit "-0.5"
Semicolon ";"
Ident "top"
Colon ":"
UnitLit "-1.5rem"
Semicolon ";"
Ident "left"
Colon ":"
UnitLit "-10%"
Semicolon ";"
RBrace "}"
RBrace "}"
Newline "\n"
