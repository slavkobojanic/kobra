# There are no keywords in style mode: `not`, `and`, `style`, `in` are Ident.
StyleKw "style"
LBrace "{"
Newline "\n"
At "@"
Ident "media"
Ident "not"
Ident "print"
Ident "and"
LParen "("
Ident "color"
RParen ")"
LBrace "{"
Dot "."
Ident "a"
LBrace "{"
Ident "style"
Colon ":"
Ident "in"
Semicolon ";"
RBrace "}"
RBrace "}"
Newline "\n"
RBrace "}"
Newline "\n"
