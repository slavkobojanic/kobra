# Normalized at compile time: the domain lower-cased, the name trimmed, the UUID lower-cased.
server contains "K Shop <orders@shop.example>"
server contains "0b6f2c1e-4d1a-4f8e-9a3b-2c5d6e7f8a9b"
server contains "https://api.stripe.com"
server lacks EmailAddress$init
server lacks Uuid$init
server lacks Shop.EXAMPLE
