func f(items: List<Int>, a: Bool, b: Bool) -> Bool {
    let positive = items
    .filter { item => item > 0 }
    .map { item => item * 2 }
    let ok = a
    and b
    let sum = 1 +
    2
    return ok
    or positive.isEmpty
}

