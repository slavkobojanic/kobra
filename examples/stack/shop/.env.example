# Configuration for `k dev --port 8081` in shop/ alone, after paybox runs on
# 8080: copy to .env (git-ignored). `k dev` at the workspace root needs none
# of this: it wires both apps itself.

K_PUBLIC_ORIGIN=http://localhost:8081

# The secret the other services sign their calls with: the same placeholder
# value as in ../paybox/.env.
K_SERVICE_TOKEN=replace-with-a-shared-development-secret

# Where paybox runs, and the secret paybox verifies the shop's calls with.
PAYBOX_URL=http://localhost:8080
PAYBOX_TOKEN=replace-with-a-shared-development-secret
