# Configuration for `k dev` in shop/ alone. Copy to .env (git-ignored).
# `k dev` at the workspace root sets all of this itself.

K_PUBLIC_ORIGIN=http://localhost:8080

# The secret the other services sign their calls with.
K_SERVICE_TOKEN=dev-only-shared-secret

# Where paybox runs, and the secret paybox verifies shop's calls with.
PAYBOX_URL=http://localhost:8081
PAYBOX_TOKEN=dev-only-shared-secret
