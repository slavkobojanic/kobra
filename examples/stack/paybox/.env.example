# Configuration for `k dev` in paybox/ alone: copy to .env (git-ignored),
# run `k dev` here (port 8080), then the shop with `k dev --port 8081` in
# ../shop. `k dev` at the workspace root needs none of this: it wires both
# apps itself.

K_PUBLIC_ORIGIN=http://localhost:8080

# The secret the other services sign their calls with. A placeholder: any
# value works, as long as ../shop/.env uses the same one.
K_SERVICE_TOKEN=replace-with-a-shared-development-secret

# Where the shop runs, and the secret it verifies paybox's calls with.
SHOP_URL=http://localhost:8081
SHOP_TOKEN=replace-with-a-shared-development-secret
