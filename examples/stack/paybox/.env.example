# Configuration for `k dev` in paybox/ alone. Copy to .env (git-ignored).
# `k dev` at the workspace root sets all of this itself.

K_PUBLIC_ORIGIN=http://localhost:8081

# The secret the other services sign their calls with.
K_SERVICE_TOKEN=dev-only-shared-secret

# Where shop runs, and the secret shop verifies paybox's calls with.
SHOP_URL=http://localhost:8080
SHOP_TOKEN=dev-only-shared-secret
