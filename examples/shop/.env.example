# Configuration for `k dev`. Copy to .env (which is git-ignored) and adjust.
# `k dev` loads .env into the environment; `k build` output and `k test`
# never read it. See docs/design/25-config-and-secrets.md.

K_PUBLIC_ORIGIN=http://localhost:3000

# Development uses SQLite, so no database server is needed.
DATABASE_URL=sqlite:.k/dev.sqlite

# Secrets point at files, exactly as in Docker. Copy the examples first:
#   for f in secrets/*.example; do cp -n "$f" "${f%.example}"; done
# The copied files hold placeholders. secrets/admin_password_hash.txt must be
# replaced with a real Argon2id hash before `k dev` starts (see README.md).
STRIPE_WEBHOOK_SECRET_FILE=secrets/stripe_webhook_secret.txt
SHOP_ADMIN_EMAIL=admin@shop.example
SHOP_ADMIN_PASSWORD_HASH_FILE=secrets/admin_password_hash.txt

# Confirmation emails go to Mailpit: `docker compose up mail`, then open
# http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
MAIL_FROM=K Shop <orders@shop.example>

# No STRIPE_API_KEY: App.k uses LocalCheckout in development, and only
# StripeCheckout reads StripeApiConfig.
