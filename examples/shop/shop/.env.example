# Configuration for `k dev`. Copy to .env (which is git-ignored) and adjust.
# `k dev` loads .env into the environment; `k build` output and `k test`
# never read it. See docs/design/25-config-and-secrets.md.
#
# `k dev` at the workspace root runs paybox on 8080 and the shop on 8081, and
# sets K_PUBLIC_ORIGIN, PAYBOX_URL, PAYBOX_TOKEN and K_SERVICE_TOKEN itself
# (one development secret for the run). Run alone, start paybox first
# (`k dev` in ../paybox) and the shop with `k dev --port 8081`.

K_PUBLIC_ORIGIN=http://localhost:8081

# Development uses SQLite, so no database server is needed.
DATABASE_URL=sqlite:.k/dev.sqlite

# Paybox, and where it calls the shop back.
PAYBOX_URL=http://127.0.0.1:8080
PAYBOX_TOKEN=dev-only-shared-secret
PAYBOX_CALLBACK_URL=http://127.0.0.1:8081

# The secret paybox's callbacks are verified with (paybox signs them with
# its own K_SERVICE_TOKEN in development).
K_SERVICE_TOKEN=dev-only-shared-secret

# Secrets point at files, exactly as in Docker; scripts/init-secrets.sh (at
# the workspace root) generates them. Relative paths are read from this
# directory.
SHOP_ADMIN_EMAIL=admin@shop.example
SHOP_ADMIN_PASSWORD_HASH_FILE=../secrets/admin_password_hash.txt

# Confirmation emails go to Mailpit: `docker compose up --detach mail` at the
# workspace root, then open http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
MAIL_FROM=K Shop <orders@shop.example>

# No Stripe variables: Stripe is an optional binding, off by default (App.k).
