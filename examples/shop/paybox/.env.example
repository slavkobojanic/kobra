# Configuration for `k dev` in paybox/ alone. Copy to .env (git-ignored).
# `k dev` at the workspace root sets K_PUBLIC_ORIGIN and K_SERVICE_TOKEN
# itself, so only DATABASE_URL is needed there.

K_PUBLIC_ORIGIN=http://localhost:8080

# Development uses SQLite, so no database server is needed.
DATABASE_URL=sqlite:.k/dev.sqlite

# The secret merchants sign their calls with. Without PAYBOX_CALLBACK_TOKEN,
# paybox signs its calls to merchants with it too, which is what a
# development shop expects.
K_SERVICE_TOKEN=dev-only-shared-secret
