# The reverse proxy in front of the shop's replicas (docker-compose.yml).
#
# Every replica is an equal `dist/app`: sessions, rate limits and the job
# queue live in Postgres (docs/design/38-deployment.md, "Several replicas"),
# so any replica can answer any request and no sticky sessions are needed.
# Caddy finds the replicas through Docker's DNS (`shop` resolves to all of
# them), sends each request to the next healthy one, and takes a replica out
# of rotation while its /health fails.
{
	# Plain HTTP on localhost; a real deployment terminates TLS here, and
	# serves HTTP/2, which server streams need (38-deployment.md).
	auto_https off
	admin off
}

:8080 {
	reverse_proxy {
		dynamic a {
			name shop
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s

		health_uri /health
		health_interval 5s
		health_timeout 3s
	}
}
