/// Creates the `product` and `order` tables for `store.Product` and
/// `store.Order`.
///
/// The demo catalog isn't seeded here: migrations run in every environment,
/// production and tests included, so they hold only data every environment
/// needs. `scripts/demo-catalog.sql` loads it for `k dev` and the end-to-end
/// test.
migration CreateCatalogAndOrders {
    func up(schema: Schema) {
        schema.createTable(name: "product") { table =>
            table.column(name: "id", type: .uuid).primaryKey(true)
            table.column(name: "slug", type: .text).unique(true)
            table.column(name: "name", type: .text)
            table.column(name: "summary", type: .text)
            table.column(name: "description", type: .text)
            table.column(name: "price", type: .money)
            table.column(name: "image_url", type: .text)
