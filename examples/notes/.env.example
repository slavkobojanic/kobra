# Copy to .env for `k dev`. `.env` is git-ignored and read only in
# development; production reads the real process environment, and `k test`
# reads neither. Format: docs/design/25-config-and-secrets.md. The variables
# are the stdlib's `DatabaseConfig`; `dist/app config` lists every variable a
# build reads.

# A SQLite file in the project's scratch directory. Migrations are applied to
# it when `k dev` starts.
DATABASE_URL=sqlite:.k/notes.db

# Production would use Postgres instead, with the password in a secret file:
# DATABASE_URL=postgres://notes@db:5432/notes
# DATABASE_PASSWORD_FILE=/run/secrets/database_password
