# Optional: `k dev` needs no .env. Without DATABASE_URL it uses a SQLite file
# at .k/notes.db (git-ignored), created and migrated at startup. Copy this to
# .env (git-ignored) only to use another database. `.env` is read only in
# development; production reads the real process environment, and `k test`
# reads neither. Format: docs/design/25-config-and-secrets.md. `dist/app
# config` lists every variable a build reads.

# Another SQLite file:
# DATABASE_URL=sqlite:.k/other.db

# Postgres, as production uses, with the password in a secret file:
# DATABASE_URL=postgres://notes@localhost:5432/notes
# DATABASE_PASSWORD_FILE=secrets/database_password
