// Generated by `k migrate new "create rooms and memberships"` from the difference between
// the entities and schema.lock, and reviewed: the three rooms that came with
// the app are stored as rows, with no creator, and each starts numbering
// after its newest message.
import k.crypto.Uuid

/// Creates `chat_room`, the rooms (the three there were, then the ones
/// people create), and `membership`, who joined each room: where they
/// stopped reading, whether they moderate it, whether they were removed.
migration CreateRoomsAndMemberships {
